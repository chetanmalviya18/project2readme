{
  "name": "@chetan_malviya/readme-cli",
  "version": "1.3.1",
  "description": "An interactive command-line interface to generate high-quality, professional README.md files.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "readme-cli": "./bin/index.js"
  },
  "scripts": {
    "start": "npx tsx src/index.ts",
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 0",
    "prepublishOnly": "npm run build && node -e \"import('fs').then(fs => fs.copyFileSync('README_NPM.md', 'README.md'))\"",
    "postpublish": "node -e \"import('fs').then(fs => fs.copyFileSync('README_GITHUB.md', 'README.md'))\""
  },
  "keywords": [
    "cli",
    "readme",
    "generator",
    "node",
    "esm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "inquirer": "^9.2.19"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
